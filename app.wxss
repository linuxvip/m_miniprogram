page {
  background: #f5f5f4;
  color: #292524;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Songti SC", "Noto Serif SC", serif;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.desc {
  display: block;
  margin-top: 12rpx;
  color: #8a8f99;
  font-size: 26rpx;
}

.btn {
  margin: 0 12rpx 0 0;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: #b45309;
  color: #ffffff;
}

.btn.ghost {
  background: #f5f5f4;
  color: #44403c;
}

.btn.block {
  width: 100%;
  margin: 40rpx 0 0;
}
