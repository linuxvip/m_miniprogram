/* 命例库（T-3.1 ~ T-3.3 / T-3.7）
 * 对照网页端 components/CaseLibrary.tsx 的 Tailwind 类，px × 2 = rpx。
 * 配色沿用全局石色 / 驼色体系，性别徽章用 theme.js 里的乾（sky）/ 坤（rose）。 */

.lib-page {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ---------------- 筛选面板 ---------------- */

.lib-panel {
  background: #ffffff;
  border: 1rpx solid var(--stone-200);
  border-radius: 40rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  box-shadow: var(--shadow-sm);
}

.lib-genders {
  display: flex;
  justify-content: center;
}

.lib-seg {
  flex: none;
}

.lib-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lib-picker {
  flex: none;
  width: 220rpx;
}

.lib-picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  background: var(--stone-100);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
}

.lib-picker-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--stone-600);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 160rpx;
}

.lib-picker-on .lib-picker-text {
  color: var(--brand);
}

.lib-search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--stone-100);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
}

.lib-search-input {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--stone-700);
}

.lib-ph {
  color: var(--stone-300);
  font-weight: 700;
}

/* 五个枚举字段：一行两个，最后一行靠左 */
.lib-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.lib-label-picker {
  width: calc((100% - 12rpx) / 2);
}

.lib-label-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--stone-100);
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
}

.lib-label-key {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--stone-400);
  flex: none;
}

.lib-label-val {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--stone-600);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lib-label-on {
  background: var(--amber-50);
  box-shadow: inset 0 0 0 1rpx var(--amber-200);
}

.lib-label-on .lib-label-val {
  color: var(--amber-700);
}

/* 四柱模糊搜索：一个字也能筛（后端 icontains） */
.lib-pillar-filter {
  display: flex;
  gap: 12rpx;
}

.lib-pillar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.lib-pillar-label {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--stone-400);
  letter-spacing: 2rpx;
  margin-left: 4rpx;
}

.lib-pillar-input {
  background: var(--stone-100);
  border-radius: 16rpx;
  padding: 12rpx 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--stone-700);
  text-align: center;
}

.lib-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--stone-100);
  padding-top: 20rpx;
}

.lib-stats-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lib-stats-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--stone-400);
}

.lib-reset {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.lib-reset-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--stone-400);
}

/* 底部说明（T-6.1 合规）：列表读到底才出现，不占视线 */
.lib-note {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-xs);
  color: var(--stone-400);
  line-height: 1.7;
  text-align: center;
}

/* 收藏按钮（T-3.6） */

.lib-fav {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin: -6rpx -6rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: transparent;
}

.lib-fav-on {
  background: #fff1f2;
}

/* ---------------- 骨架屏 / 空态 / 错误态 ---------------- */

.lib-skeleton {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lib-sk-card {
  background: #ffffff;
  border: 1rpx solid var(--stone-200);
  border-radius: 40rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lib-sk-line {
  height: 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(90deg, #f5f5f4 25%, #ececea 37%, #f5f5f4 63%);
  background-size: 400% 100%;
  animation: lib-sk 1.4s ease infinite;
}

.lib-sk-line-1 { width: 40%; }
.lib-sk-line-2 { width: 100%; height: 88rpx; }
.lib-sk-line-3 { width: 80%; }

@keyframes lib-sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.lib-state {
  background: #ffffff;
  border: 2rpx dashed var(--stone-200);
  border-radius: 40rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.lib-state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--stone-400);
}

.lib-state-title-error {
  color: #be123c;
}

.lib-state-desc {
  font-size: 24rpx;
  color: var(--stone-300);
  text-align: center;
}

.lib-state-btn {
  margin-top: 16rpx;
  padding: 16rpx 36rpx;
  background: var(--amber-50);
  box-shadow: inset 0 0 0 1rpx var(--amber-200);
  color: var(--amber-700);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 20rpx;
}

/* ---------------- 命例卡片 ---------------- */

.lib-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lib-card {
  background: #ffffff;
  border: 1rpx solid var(--stone-200);
  border-radius: 32rpx;
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: var(--shadow-sm);
}

.lib-card-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.lib-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex: none;
}

.lib-gender-male {
  background: #f0f9ff;
  color: #0369a1;
}

.lib-gender-female {
  background: #fff1f2;
  color: #be123c;
}

.lib-card-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.lib-source {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--stone-800);
}

.lib-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.lib-tag {
  font-size: 20rpx;
  color: #b45309;
  background: #fffbeb;
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
  white-space: nowrap;
}

.lib-tag-more {
  font-size: 20rpx;
  color: var(--stone-400);
  padding: 4rpx 6rpx;
}

/* 四柱（每柱两字，竖排） */
.lib-pillars {
  display: flex;
  justify-content: space-between;
  background: rgba(245, 245, 244, 0.5);
  border: 1rpx solid var(--stone-100);
  border-radius: 24rpx;
  padding: 18rpx 40rpx;
}

.lib-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.lib-char {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}

.lib-feedback {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.lib-feedback-text {
  font-size: 24rpx;
  color: var(--stone-500);
  line-height: 1.7;
}

.lib-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.lib-feedback-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.lib-open {
  display: flex;
  align-items: center;
  gap: 2rpx;
  flex: none;
}

.lib-open-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand);
}

.lib-expand {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 0;
}

.lib-expand-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #b45309;
}

/* ---------------- 加载更多 / 到底 ---------------- */

.lib-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid var(--stone-200);
  border-radius: 28rpx;
}

.lib-more-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--stone-500);
}

.lib-end {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 8rpx;
}

.lib-end-text {
  font-size: 22rpx;
  color: var(--stone-300);
  letter-spacing: 2rpx;
}
