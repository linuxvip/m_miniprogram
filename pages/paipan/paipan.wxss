/* 排盘页专有样式。通用色值/字号/圆角一律取自 app.wxss 的变量，此处不再写死颜色。 */

/* ---------- 四柱表 ---------- */
.pillars {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.pillar {
  flex: 1;
  min-width: 0;
  padding: var(--sp-3) var(--sp-1);
  background: var(--stone-50);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  text-align: center;
}

.pillar-label {
  display: block;
  color: var(--stone-400);
  font-size: var(--fs-xs);
}

.ganzhi {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: var(--sp-2) 0 var(--sp-3);
}

/* 干支大字：颜色由 .el-* 控制，这里只管字型 */
.gz {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cell {
  display: block;
  color: var(--stone-600);
  font-size: var(--fs-xs);
  line-height: 1.6;
  white-space: nowrap;
}

.cell-row {
  margin-top: var(--sp-1);
}

.cell-key {
  display: block;
  color: var(--stone-400);
  font-size: var(--fs-xs);
}

.stack {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ---------- 五行统计 ---------- */
.wuxing {
  display: flex;
  gap: var(--sp-2);
  margin: var(--sp-3) 0 var(--sp-1);
}

.wx-item {
  flex: 1;
  padding: var(--sp-3) 0;
  background: var(--stone-50);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  text-align: center;
}

.wx-el {
  display: block;
  font-size: var(--fs-lg);
  font-weight: 600;
}

.wx-count {
  display: block;
  margin-top: 6rpx;
  color: var(--stone-500);
  font-size: var(--fs-sm);
}
