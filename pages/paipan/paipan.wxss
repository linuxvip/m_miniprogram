/* 排盘输入页专有样式。颜色/字号/圆角一律取 app.wxss 的变量。 */

/* ---------- 姓名 ---------- */
.name-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding-bottom: var(--sp-3);
  border-bottom: 1rpx solid var(--stone-200);
}

.name-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--stone-800);
}

.name-ph { color: var(--stone-300); }

/* ---------- 分段控件宽度 ---------- */
.seg-300 { width: 300rpx; }

/* ---------- 选择行 ---------- */
.field-picker {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  max-width: 420rpx;
  padding: 12rpx 20rpx;
  background: var(--stone-100);
  border: 1rpx solid transparent;
  border-radius: var(--radius-md);
}

.picker-text {
  color: var(--stone-700);
  font-size: var(--fs-sm);
  font-weight: 600;
}

.picker-zhu {
  display: flex;
  align-items: center;
  font-size: var(--fs-base);
  font-weight: 600;
}

.geo-hint {
  display: block;
  padding-top: var(--sp-2);
  text-align: right;
  color: var(--stone-400);
  font-size: var(--fs-xs);
}

/* ---------- 高级设置 ---------- */
.advanced {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 1rpx solid var(--line);
}

.adv-head {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.adv-title {
  color: var(--stone-400);
  font-size: var(--fs-xs);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.adv-arrow {
  color: var(--stone-400);
  font-size: var(--fs-xs);
  transition: transform 0.2s;
}

.adv-arrow-on { transform: rotate(180deg); }

.adv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  margin-top: var(--sp-2);
  padding: 20rpx var(--sp-3);
  background: var(--stone-100);
  border-radius: var(--radius-md);
}

.adv-text { flex: 1; min-width: 0; }

.adv-name {
  display: block;
  color: var(--stone-700);
  font-size: var(--fs-sm);
  font-weight: 600;
}

.adv-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--stone-400);
  font-size: var(--fs-xs);
}

.adv-select {
  padding: 10rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid var(--stone-200);
  border-radius: var(--radius-sm);
  color: var(--stone-700);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.adv-input {
  margin-top: var(--sp-2);
  padding: 20rpx var(--sp-3);
  background: var(--stone-100);
  border: 1rpx solid var(--stone-200);
  border-radius: var(--radius-md);
  color: var(--stone-700);
  font-size: var(--fs-sm);
  font-weight: 600;
}

/* 开关：对应网页端 w-9 h-5 rounded-full */
.switch {
  position: relative;
  flex-shrink: 0;
  width: 76rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: var(--stone-300);
  transition: background 0.2s;
}

.switch-on { background: var(--brand); }

.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: var(--shadow-sm);
  transition: left 0.2s;
}

.switch-on .switch-knob { left: 36rpx; }

/* ---------- 即时局预览 ---------- */
.live {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-5);
  padding-top: var(--sp-4);
  border-top: 1rpx solid var(--line);
}

.clock {
  position: relative;
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border: 1rpx solid var(--stone-200);
  border-radius: 50%;
  background: var(--paper);
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.clock-tick {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 6rpx;
  margin: -3rpx 0 0 -3rpx;
  border-radius: 50%;
  background: var(--stone-300);
}

.clock-hand {
  position: absolute;
  left: 50%;
  bottom: 50%;
  border-radius: var(--radius-full);
  transform-origin: 50% 100%;
}

.clock-hand-hour {
  width: 4rpx;
  height: 28rpx;
  margin-left: -2rpx;
  background: var(--ink);
}

.clock-hand-minute {
  width: 2rpx;
  height: 40rpx;
  margin-left: -1rpx;
  background: var(--stone-400);
}

.clock-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  background: var(--ink);
  border: 2rpx solid #ffffff;
}

.live-body {
  flex: 1;
  min-width: 0;
}

.live-pillars {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.live-pillar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.live-label {
  color: var(--stone-400);
  font-size: var(--fs-xs);
  font-weight: 600;
  line-height: 1;
}

.char-box {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-width: 1rpx;
  border-style: solid;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.live-line {
  display: block;
  color: var(--stone-500);
  font-size: var(--fs-xs);
  font-weight: 600;
}

.live-line-sub {
  margin-top: 4rpx;
  color: var(--stone-400);
  font-weight: 400;
}
