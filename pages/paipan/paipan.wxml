<view class="page">
  <view class="card">
    <text class="title">四柱排盘</text>
    <text class="desc">按传统历法推算，输入出生时间即可</text>

    <view class="field">
      <text class="field-label">出生日期</text>
      <picker mode="date" value="{{date}}" start="1900-01-01" end="2100-12-31" bindchange="onDateChange">
        <view class="picker">{{date}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">出生时间</text>
      <picker mode="time" value="{{time}}" bindchange="onTimeChange">
        <view class="picker">{{time}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="field-label">性别</text>
      <radio-group class="radios" bindchange="onGenderChange">
        <label class="radio">
          <radio value="MALE" checked="{{gender === 'MALE'}}" color="#b45309" />
          <text>乾造（男）</text>
        </label>
        <label class="radio">
          <radio value="FEMALE" checked="{{gender === 'FEMALE'}}" color="#b45309" />
          <text>坤造（女）</text>
        </label>
      </radio-group>
    </view>

    <button class="btn primary block" bindtap="calculate">开始排盘</button>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>

  <block wx:if="{{result}}">
    <view class="card">
      <text class="title">四柱</text>
      <view class="pillars">
        <view class="pillar" wx:for="{{pillars}}" wx:key="label">
          <text class="pillar-label">{{item.label}}</text>
          <view class="ganzhi">
            <text class="gz {{item.ganClass}}">{{item.gan}}</text>
            <text class="gz {{item.zhiClass}}">{{item.zhi}}</text>
          </view>
          <text class="cell">{{item.shiShen}}</text>
          <view class="cell-row">
            <text class="cell-key">藏干</text>
            <text class="cell">{{item.cangGan}}</text>
          </view>
          <view class="cell-row">
            <text class="cell-key">十神</text>
            <view class="stack">
              <text class="cell" wx:for="{{item.cangGanShiShen}}" wx:for-item="shiShen" wx:key="*this">{{shiShen}}</text>
            </view>
          </view>
          <view class="cell-row">
            <text class="cell-key">纳音</text>
            <text class="cell">{{item.naYin}}</text>
          </view>
          <view class="cell-row">
            <text class="cell-key">星运</text>
            <text class="cell">{{item.xingYun}}</text>
          </view>
          <view class="cell-row">
            <text class="cell-key">空亡</text>
            <text class="cell">{{item.xunKong}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="title">基础信息</text>
      <view class="row">
        <text class="row-key">公历</text>
        <text class="row-val">{{result.solarDate}}</text>
      </view>
      <view class="row">
        <text class="row-key">农历</text>
        <text class="row-val">{{result.lunarDate}}</text>
      </view>
      <view class="row">
        <text class="row-key">节气</text>
        <text class="row-val">{{result.jieQi}}</text>
      </view>
      <view class="row">
        <text class="row-key">生肖 / 星座</text>
        <text class="row-val">{{result.zodiac}} / {{result.constellation}}（{{result.weekDay}}）</text>
      </view>
      <view class="row">
        <text class="row-key">日主</text>
        <text class="row-val">{{result.dayMasterElement}}　{{result.strengthLevel}}</text>
      </view>
      <view class="row">
        <text class="row-key">大运</text>
        <text class="row-val">{{result.yunDirection}}　{{result.qiYunText}}</text>
      </view>
      <view class="row" wx:if="{{result.siLingDesc}}">
        <text class="row-key">月令司令</text>
        <text class="row-val">{{result.siLingDesc}}</text>
      </view>
    </view>

    <view class="card">
      <text class="title">五行统计</text>
      <view class="wuxing">
        <view class="wx-item" wx:for="{{result.wuXing}}" wx:key="element">
          <text class="wx-el {{item.cls}}">{{item.element}}</text>
          <text class="wx-count">{{item.count}}</text>
        </view>
      </view>
      <text class="desc" wx:if="{{result.strengthDesc}}">{{result.strengthDesc}}</text>
    </view>

    <view class="card" wx:if="{{result.shenSha.length}}">
      <text class="title">神煞</text>
      <view class="tags">
        <view class="tag" wx:for="{{result.shenSha}}" wx:key="name">
          <text class="tag-name">{{item.name}}</text>
          <text class="tag-pos">{{item.pos}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
